// .markdownlint-cli2.jsonc
//
// CLI2-only options for `markdownlint-cli2` (consumed by the markdownlint
// CI job via `DavidAnson/markdownlint-cli2-action`). The MARKDOWNLINT RULES
// live in `.markdownlint.json` (which markdownlint-cli2 prefers over any
// `config:` block in this file when both exist - per cli2 docs).
//
// Ignores:
//   - `CLAUDE.md`      - uses an `@AGENTS.md` import directive at line 1
//                        (not a Markdown h1); special form.
//   - `node_modules/`  - vendor; never tracked.
{
  "ignores": [
    "CLAUDE.md",
    "node_modules/**"
  ]
}
