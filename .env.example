# .env.example — copy to .env and fill in real values before running scripts/preflight.sh
# NEVER commit .env to git (see .gitignore)
#
# Usage: cp .env.example .env
#        Then edit .env and replace all placeholder values.

# GitHub repository name (without the owner prefix, e.g. "karyon")
GITHUB_REPO=your-repo-name

# GitHub username or organization that owns the repository
GITHUB_OWNER=your-github-username

# Personal Access Token with 'repo' scope.
# Generate at: https://github.com/settings/tokens/new?scopes=repo
# Used by scripts/preflight.sh (presence check only — not validated against GitHub API)
GITHUB_TOKEN=ghp_REPLACE_WITH_PAT_WITH_repo_SCOPE
